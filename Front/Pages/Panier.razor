@page "/panier"
@using Front.Models
@using Front.Services
@inject CartService CartService
@inject AuthService Auth
@inject NavigationManager Nav
@inject OrderService OrderService
@inject IJSRuntime JSRuntime

<div class="container-fluid py-4">
    <!-- En-tête -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="bi bi-cart-fill me-2 text-primary"></i>
                Mon Panier
            </h1>
            <p class="text-muted mt-1">Gérez vos articles sélectionnés</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="GoToMenu">
            <i class="bi bi-arrow-left me-2"></i>
            Continuer mes achats
        </button>
    </div>

    @if (!isLoaded)
    {
        <!-- État de chargement -->
        <div class="text-center py-5">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
            <p class="mt-3 text-muted">Chargement de votre panier...</p>
        </div>
    }
    else if (cart.CartItems.Count == 0)
    {
        <!-- Panier vide -->
        <div class="text-center py-5">
            <div class="empty-cart-icon mb-4">
                <i class="bi bi-cart-x fs-1 text-muted"></i>
            </div>
            <h4 class="text-muted mb-3">Votre panier est vide</h4>
            <p class="text-muted mb-4">Ajoutez des articles depuis notre menu pour commencer vos achats.</p>
            <button class="btn btn-primary btn-lg" @onclick="GoToMenu">
                <i class="bi bi-menu-button-wide me-2"></i>
                Voir le menu
            </button>
        </div>
    }
    else
    {
        <!-- Contenu du panier -->
        <div class="row">
            <!-- Articles du panier -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light border-0">
                        <h5 class="mb-0">
                            <i class="bi bi-receipt me-2"></i>
                            Articles dans votre panier (@cart.CartItems.Count)
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @foreach (var item in cart.CartItems)
                        {
                            <div class="d-flex align-items-center p-3 border-bottom">
                                <div class="flex-shrink-0 me-3">
                                    <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                         style="width: 50px; height: 50px;">
                                        @(item.Article?.Name?.Substring(0, Math.Min(1, item.Article.Name.Length)) ?? "?")
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-1">@item.Article?.Name</h6>
                                    <small class="text-muted">@item.Quantity x @item.UnitPrice.ToString("0.00") TND</small>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold text-success h5 mb-0">
                                        @((item.Quantity * item.UnitPrice).ToString("0.00")) TND
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Résumé de commande -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm sticky-top" style="top: 20px;">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="bi bi-calculator me-2"></i>
                            Résumé de commande
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <span>Sous-total</span>
                            <span class="fw-semibold">@cart.TotalAmount.ToString("0.00") TND</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Livraison</span>
                            <span class="text-success fw-semibold">Gratuite</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-4">
                            <span class="h5 mb-0">Total</span>
                            <span class="h4 mb-0 text-primary fw-bold">@cart.TotalAmount.ToString("0.00") TND</span>
                        </div>

                        <button class="btn btn-success btn-lg w-100" @onclick="PasserCommande">
                            <i class="bi bi-check-circle me-2"></i>
                            Passer la commande
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .empty-cart-icon {
        opacity: 0.5;
    }

    .avatar {
        font-size: 1.2rem;
    }
</style>

@code {
    private Cart cart = new Cart();
    private bool isLoaded = false;

    // Charger le panier au démarrage
    protected override async Task OnInitializedAsync()
    {
        await LoadCart();
    }

    // Charger le panier de l'utilisateur
    private async Task LoadCart()
    {
        // Vérifier si connecté
        var token = await Auth.GetTokenAsync();
        if (string.IsNullOrEmpty(token))
        {
            Nav.NavigateTo("/login");
            return;
        }

        // Récupérer l'ID utilisateur
        var userId = await Auth.GetUserIdAsync();
        if (string.IsNullOrEmpty(userId))
        {
            Nav.NavigateTo("/login");
            return;
        }

        // Récupérer le panier
        var cartData = await CartService.GetCartAsync(userId);
        if (cartData != null)
            cart = cartData;

        isLoaded = true;
    }

    // Passer la commande
    private async Task PasserCommande()
    {
        try
        {
            // Vérifier l'utilisateur
            var userId = await Auth.GetUserIdAsync();
            if (string.IsNullOrEmpty(userId))
            {
                Nav.NavigateTo("/login");
                return;
            }

            // Créer la commande à partir du panier
            var order = new Order
            {
                UserId = userId,
                TotalAmount = cart.TotalAmount,
                Status = "Pending",
                PaymentStatus = "Pending",
                OrderDate = DateTime.Now,
                OrderItems = cart.CartItems.Select(ci => new OrderItem
                {
                    Article = ci.Article,
                    Quantity = ci.Quantity,
                    UnitPrice = ci.UnitPrice
                }).ToList()
            };

            // Envoyer la commande à l'API
            var createdOrder = await OrderService.CreateOrderAsync(order);

            if (createdOrder != null)
            {
                // Vider le panier après commande réussie
                await CartService.ClearCartAsync(userId);

                // Rediriger vers les commandes
                Nav.NavigateTo("/orders");
            }
            else
            {
                // Afficher une erreur
                await JSRuntime.InvokeVoidAsync("alert", "Erreur lors de la création de la commande");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Erreur: {ex.Message}");
        }
    }

    // Aller au menu
    private void GoToMenu()
    {
        Nav.NavigateTo("/menu");
    }
}