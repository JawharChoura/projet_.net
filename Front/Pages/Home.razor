@page "/"
@inject NavigationManager Nav
@inject AuthService Auth
@using Front.Services

<div class="hero-section bg-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-3">Bienvenue chez MonResto</h1>
                <p class="lead mb-4">
                    Découvrez nos délicieux plats préparés avec des ingrédients frais.
                    Commandez en ligne et faites-vous livrer ou venez déguster sur place !
                </p>
                <div class="d-flex gap-3">
                    <button class="btn btn-light btn-lg" @onclick="GoToMenu">
                        <i class="bi bi-menu-button-wide me-2"></i>
                        Voir le Menu
                    </button>
                    @if (!isAuthenticated)
                    {
                        <button class="btn btn-outline-light btn-lg" @onclick="GoToRegister">
                            <i class="bi bi-person-plus me-2"></i>
                            S'inscrire
                        </button>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="text-center">
                    <i class="bi bi-restaurant" style="font-size: 8rem; opacity: 0.8;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="features-section py-5 bg-light">
    <div class="container">
        <div class="row text-center">
            <div class="col-md-4 mb-4">
                <div class="feature-card h-100 p-4 bg-white rounded shadow-sm">
                    <i class="bi bi-clock text-primary" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">Livraison Rapide</h4>
                    <p class="text-muted">Commandez et recevez votre repas en moins de 30 minutes.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card h-100 p-4 bg-white rounded shadow-sm">
                    <i class="bi bi-star text-primary" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">Qualité Premium</h4>
                    <p class="text-muted">Ingrédients frais et préparation artisanale pour un goût incomparable.</p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="feature-card h-100 p-4 bg-white rounded shadow-sm">
                    <i class="bi bi-credit-card text-primary" style="font-size: 3rem;"></i>
                    <h4 class="mt-3">Paiement Sécurisé</h4>
                    <p class="text-muted">Vos informations de paiement sont protégées par nos systèmes de sécurité.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isAuthenticated = false;

    protected override async Task OnInitializedAsync()
    {
        // Vérifier si l'utilisateur est connecté
        var token = await Auth.GetTokenAsync();
        isAuthenticated = !string.IsNullOrEmpty(token);
    }

    private void GoToMenu()
    {
        Nav.NavigateTo("/menu");
    }

    private void GoToRegister()
    {
        Nav.NavigateTo("/register");
    }
}

<style>
    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 60vh;
        display: flex;
        align-items: center;
    }

    .feature-card {
        transition: transform 0.3s ease;
    }

        .feature-card:hover {
            transform: translateY(-5px);
        }
</style>
