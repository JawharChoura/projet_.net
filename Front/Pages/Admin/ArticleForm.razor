@page "/admin/articleform"
@page "/admin/articleform/{ArticleId:int}"
@using Front.Models
@using Front.Services
@inject ArticleService ArticleService
@inject CategoryService CategoryService
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<div class="container py-4">
    <h1 class="mb-4">@(isEditMode ? "Modifier l'article" : "Nouvel Article")</h1>

    @if (!isAdmin)
    {
        <div class="alert alert-danger">
            <p>Accès réservé aux administrateurs.</p>
            <button class="btn btn-secondary" @onclick="GoToArticles">Retour à la liste</button>
        </div>
    }
    else if (loading)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
            <p class="mt-2">Chargement du formulaire...</p>
        </div>
    }
    else
    {
        <div class="card shadow">
            <div class="card-body">
                <EditForm Model="article" OnValidSubmit="SaveArticle">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="alert alert-danger" />

                    <!-- Champ Nom -->
                    <div class="mb-3">
                        <label class="form-label">Nom de l'article *</label>
                        <InputText @bind-Value="article.Name" class="form-control"
                                   placeholder="Ex: Pizza Margherita" />
                        <ValidationMessage For="@(() => article.Name)" class="text-danger small" />
                    </div>

                    <!-- Champ Description -->
                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <InputTextArea @bind-Value="article.Description" class="form-control"
                                       placeholder="Description détaillée..." rows="3" />
                    </div>

                    <!-- Prix et Catégorie -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Prix (TND) *</label>
                            <InputNumber @bind-Value="article.Price" class="form-control"
                                         placeholder="0.00" />
                            <ValidationMessage For="@(() => article.Price)" class="text-danger small" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Catégorie *</label>
                            <InputSelect @bind-Value="article.CategoryId" class="form-control">
                                <option value="">Sélectionner une catégorie</option>
                                @if (categories != null && categories.Any())
                                {
                                    @foreach (var category in categories)
                                    {
                                        <option value="@category.Id">@category.Name</option>
                                    }
                                }
                                else
                                {
                                    <option value="">Aucune catégorie disponible</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => article.CategoryId)" class="text-danger small" />
                        </div>
                    </div>

                    <!-- Image URL -->
                    <div class="mb-3">
                        <label class="form-label">URL de l'image</label>
                        <InputText @bind-Value="article.ImageUrl" class="form-control"
                                   placeholder="https://example.com/image.jpg" />
                        <div class="form-text">Laissez vide si pas d'image</div>
                    </div>

                    <!-- Boutons d'action -->
                    <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                        <button type="button" class="btn btn-secondary" @onclick="Cancel" disabled="@isSaving">
                            <i class="bi bi-arrow-left me-1"></i> Annuler
                        </button>

                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>Enregistrement...</span>
                            }
                            else if (isEditMode)
                            {
                                <i class="bi bi-save me-1"></i>
                                <span>Mettre à jour</span>
                            }
                            else
                            {
                                <i class="bi bi-plus-circle me-1"></i>
                                <span>Créer l'article</span>
                            }
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>

        <!-- Aperçu de l'article -->
        @if (!string.IsNullOrEmpty(article.Name))
        {
            <div class="card mt-4 shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-eye me-2"></i>Aperçu</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3">
                            @if (!string.IsNullOrEmpty(article.ImageUrl))
                            {
                                <img src="@article.ImageUrl" alt="@article.Name"
                                     class="img-fluid rounded" style="max-height: 150px;" />
                            }
                            else
                            {
                                <div class="bg-light rounded d-flex align-items-center justify-content-center"
                                     style="height: 150px;">
                                    <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-9">
                            <h5>@article.Name</h5>
                            <p class="text-muted">@(article.Description ?? "Pas de description")</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="h4 text-primary">@article.Price.ToString("0.00") TND</span>
                                <span class="badge bg-info">
                                    @{
                                        var categoryName = categories?.FirstOrDefault(c => c.Id == article.CategoryId)?.Name
                                        ?? "Catégorie";
                                    }
                                    @categoryName
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public int ArticleId { get; set; }

    private Article article = new();
    private List<Category> categories = new();
    private bool isAdmin = false;
    private bool isEditMode = false;
    private bool isSaving = false;
    private bool loading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Vérifier les droits administrateur
            var roles = await Auth.GetRolesAsync();
            isAdmin = roles?.Contains("Admin") == true;

            if (!isAdmin)
            {
                loading = false;
                return;
            }

            // Charger les catégories
            await LoadCategories();

            // Vérifier si on est en mode édition
            if (ArticleId > 0)
            {
                isEditMode = true;
                await LoadArticle();
            }
            else
            {
                // Initialiser un nouvel article avec des valeurs par défaut
                article = new Article
                {
                    Price = 0,
                    CategoryId = categories.FirstOrDefault()?.Id ?? 0
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur d'initialisation: {ex.Message}";
            await ShowAlert("Erreur", errorMessage);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await CategoryService.GetAllAsync() ?? new List<Category>();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors du chargement des catégories: {ex.Message}";
            await ShowAlert("Erreur", errorMessage);
        }
    }

    private async Task LoadArticle()
    {
        try
        {
            var loadedArticle = await ArticleService.GetByIdAsync(ArticleId);
            if (loadedArticle != null)
            {
                article = loadedArticle;
            }
            else
            {
                await ShowAlert("Erreur", "Article non trouvé");
                GoToArticles();
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors du chargement de l'article: {ex.Message}";
            await ShowAlert("Erreur", errorMessage);
        }
    }

    private async Task SaveArticle()
    {
        if (isSaving) return;

        isSaving = true;
        errorMessage = string.Empty;

        try
        {
            // Validation supplémentaire
            if (article.CategoryId <= 0)
            {
                await ShowAlert("Erreur", "Veuillez sélectionner une catégorie");
                isSaving = false;
                return;
            }

            if (article.Price <= 0)
            {
                await ShowAlert("Erreur", "Le prix doit être supérieur à 0");
                isSaving = false;
                return;
            }

            if (isEditMode)
            {
                // Mise à jour de l'article existant
                await ArticleService.UpdateAsync(article.Id, article);
                await ShowAlert("Succès", "Article mis à jour avec succès !");
            }
            else
            {
                // Création d'un nouvel article
                await ArticleService.AddAsync(article);
                await ShowAlert("Succès", "Article créé avec succès !");
            }

            // Petite pause avant la redirection
            await Task.Delay(1500);

            // Retour à la liste
            GoToArticles();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors de la sauvegarde: {ex.Message}";
            await ShowAlert("Erreur", errorMessage);
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async void Cancel()
    {
        if (isSaving) return;

        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm",
            "Voulez-vous vraiment annuler ? Les modifications non enregistrées seront perdues.");

        if (confirm)
        {
            GoToArticles();
        }
    }

    private async Task ShowAlert(string title, string message)
    {
        await JSRuntime.InvokeVoidAsync("alert", $"{title}\n\n{message}");
    }

    private void GoToArticles()
    {
        Nav.NavigateTo("/admin/articles");
    }

    // Méthode pour mettre à jour l'aperçu en temps réel
    private void OnFieldChanged()
    {
        // Force le rafraîchissement de l'UI pour l'aperçu
        StateHasChanged();
    }
}