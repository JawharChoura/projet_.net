@page "/admin/articles"
@using Front.Models
@using Front.Services
@inject ArticleAdminService ArticleService
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">
                <i class="bi bi-egg-fried me-2 text-primary"></i>
                Gestion des Articles
            </h1>
            <p class="text-muted mt-1">Gérez votre menu restaurant</p>
        </div>
        <button class="btn btn-primary btn-lg" @onclick="NavigateToAddArticle">
            <i class="bi bi-plus-circle me-2"></i>
            Nouvel Article
        </button>
    </div>

    @if (!isAdmin)
    {
        <div class="alert alert-danger border-0 shadow-sm">
            <div class="d-flex align-items-center">
                <i class="bi bi-shield-lock-fill me-3 fs-4"></i>
                <div>
                    <h5 class="alert-heading mb-1">Accès refusé</h5>
                    <p class="mb-0">Cette page est réservée aux administrateurs.</p>
                </div>
            </div>
        </div>
    }
    else if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Chargement...</span>
            </div>
            <p class="mt-3 text-muted">Chargement des articles...</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                @if (articles == null || !articles.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox fs-1 text-muted mb-3"></i>
                        <h5 class="text-muted">Aucun article disponible</h5>
                        <p class="text-muted">Commencez par ajouter votre premier article.</p>
                        <button class="btn btn-primary" @onclick="NavigateToAddArticle">
                            <i class="bi bi-plus-circle me-2"></i>
                            Ajouter un article
                        </button>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="border-0 fw-semibold">#</th>
                                    <th class="border-0 fw-semibold">Article</th>
                                    <th class="border-0 fw-semibold">Prix</th>
                                    <th class="border-0 fw-semibold">Catégorie</th>
                                    <th class="border-0 fw-semibold text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var article in articles)
                                {
                                    <tr class="align-middle">
                                        <td class="text-muted small">@article.Id</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-3 fw-bold">
                                                    @article.Name?[0]
                                                </div>
                                                <div>
                                                    <div class="fw-semibold">@article.Name</div>
                                                    <small class="text-muted">@article.Description</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-success fs-6 px-3 py-2">
                                                @article.Price.ToString("0.00") TND
                                            </span>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark px-3 py-2">
                                                @(article.Category?.Name ?? "Non définie")
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <button class="btn btn-sm btn-outline-primary"
                                                        @onclick="@(() => EditArticle(article.Id))"
                                                        title="Modifier">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger"
                                                        @onclick="@(() => ConfirmDelete(article.Id))"
                                                        title="Supprimer">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<Article>? articles;
    private bool loading = true;
    private bool isAdmin = false;

    protected override async Task OnInitializedAsync()
    {
        var roles = await Auth.GetRolesAsync();
        isAdmin = roles?.Contains("Admin") == true;

        if (isAdmin)
        {
            await LoadArticles();
        }
        else
        {
            loading = false;
        }
    }

    private async Task LoadArticles()
    {
        try
        {
            loading = true;
            articles = await ArticleService.GetAllAsync() ?? new List<Article>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des articles: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "Impossible de charger les articles depuis le serveur.");
        }
        finally
        {
            loading = false;
        }
    }

    private void NavigateToAddArticle()
    {
        Nav.NavigateTo("/admin/articleform");
    }

    private void EditArticle(int articleId)
    {
        Nav.NavigateTo($"/admin/articleform/{articleId}");
    }

    private async Task ConfirmDelete(int articleId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm",
            "Êtes-vous sûr de vouloir supprimer cet article ? Cette action est irréversible.");

        if (confirmed)
        {
            await DeleteArticle(articleId);
        }
    }

    private async Task DeleteArticle(int articleId)
    {
        try
        {
            var success = await ArticleService.DeleteAsync(articleId);
            if (success)
            {
                await LoadArticles();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Erreur lors de la suppression de l'article.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la suppression: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("alert", "Une erreur est survenue lors de la suppression.");
        }
    }
}
